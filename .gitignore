# PaperReader materials and artifacts stay local.
PaperReader/outputs/
PaperReader/inputs/
**/.cache/
**/tmp/
**/__pycache__/
*.py[cod]
**/.venv/
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db

# TextReadable input and edited text stay local.
TextReadable/inputs/
TextReadable/outputs/

# NewsChaser real news, sources, indexes and reviews stay local.
NewsChaser/inputs/
NewsChaser/outputs/

# ResearchHotspotFollow papers, sources, history and reviews stay local.
ResearchHotspotFollow/inputs/
ResearchHotspotFollow/outputs/

# ResearchFieldSurvey real inputs and artifacts stay local.
ResearchFieldSurvey/inputs/
ResearchFieldSurvey/outputs/

# Reference PDF downloads and user-provided originals stay local.
shared/references/ccf/*.pdf
shared/references/ccf/history/

# PaperReviewer private manuscripts, revisions and review records stay local.
PaperReviewer/inputs/
PaperReviewer/outputs/

# PPTMaker private materials, templates, generated decks and review artifacts.
PPTMaker/inputs/
PPTMaker/outputs/

# XRWritting manuscripts, reference downloads and audit artifacts stay local.
XRWritting/inputs/
XRWritting/outputs/

# PaperFigureAgent private input, generated figures, runtimes and task state.
PaperFigureAgent/inputs/
PaperFigureAgent/outputs/
PaperFigureAgent/*.egg-info/

# Private reference identity maps must stay outside published configuration.
XRWritting/private/
XRWritting/references/private/
